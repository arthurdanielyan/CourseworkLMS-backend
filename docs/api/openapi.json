{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Library Management System API",
    "version" : "v1"
  },
  "security" : [ {
    "bearer" : [ ]
  } ],
  "paths" : {
    "/api/v1/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenPairResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ ],
        "tags" : [ "session-controller" ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenPairResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ ],
        "tags" : [ "session-controller" ]
      }
    },
    "/api/v1/auth/registrations" : {
      "post" : {
        "operationId" : "start",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/StartRegistrationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PendingRegistrationResponse"
                }
              }
            },
            "description" : "Accepted"
          }
        },
        "security" : [ ],
        "tags" : [ "registration-controller" ]
      }
    },
    "/api/v1/auth/registrations/resend" : {
      "post" : {
        "operationId" : "resend",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ResendCodeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PendingRegistrationResponse"
                }
              }
            },
            "description" : "Accepted"
          }
        },
        "security" : [ ],
        "tags" : [ "registration-controller" ]
      }
    },
    "/api/v1/auth/registrations/verify" : {
      "post" : {
        "operationId" : "verify",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/VerifyCodeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenPairResponse"
                }
              }
            },
            "description" : "Created"
          }
        },
        "security" : [ ],
        "tags" : [ "registration-controller" ]
      }
    },
    "/api/v1/books" : {
      "get" : {
        "operationId" : "search",
        "parameters" : [ {
          "description" : "Text in the title, the subtitle or an author's name, ignoring case",
          "example" : "clean code",
          "in" : "query",
          "name" : "q",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Text in an author's name, ignoring case",
          "example" : "martin",
          "in" : "query",
          "name" : "author",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "example" : 2008,
          "in" : "query",
          "name" : "publication_year",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "description" : "Books in any of these categories; repeat the parameter for more than one",
          "in" : "query",
          "name" : "category_id",
          "required" : false,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int32"
            }
          }
        }, {
          "description" : "Books in any of these languages; repeat the parameter for more than one",
          "in" : "query",
          "name" : "language_id",
          "required" : false,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int32"
            }
          }
        }, {
          "description" : "true: only Available books; false: only Unavailable ones; leave out for both",
          "in" : "query",
          "name" : "available",
          "required" : false,
          "schema" : {
            "type" : "boolean"
          }
        }, {
          "description" : "Books owned by any of these teachers; repeat the parameter for more than one",
          "in" : "query",
          "name" : "owner_id",
          "required" : false,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int32"
            }
          }
        }, {
          "description" : "true: University Books match too, alongside any owner_id books",
          "in" : "query",
          "name" : "university",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        }, {
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 0
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseBookSummaryResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "book-controller" ]
      }
    },
    "/api/v1/books/owners" : {
      "get" : {
        "operationId" : "owners",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "example" : [ {
                  "id" : 4,
                  "name" : "Ella Hovhannisyan"
                } ],
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/NamedItemResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The teachers who own at least one book, sorted by name; University Books are filtered by `university=true` instead",
        "tags" : [ "catalog-lookup-controller" ]
      }
    },
    "/api/v1/books/{id}" : {
      "get" : {
        "operationId" : "details",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookDetailsResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "book-controller" ]
      }
    },
    "/api/v1/categories" : {
      "get" : {
        "operationId" : "categories",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "example" : [ {
                  "id" : 14,
                  "name" : "Architecture"
                }, {
                  "id" : 12,
                  "name" : "Art"
                } ],
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/NamedItemResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Every category, sorted by name",
        "tags" : [ "catalog-lookup-controller" ]
      }
    },
    "/api/v1/favourites" : {
      "get" : {
        "operationId" : "list",
        "parameters" : [ {
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 0
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseBookSummaryResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The logged-in user's Favourites, the most recently added first",
        "tags" : [ "favourite-controller" ]
      }
    },
    "/api/v1/favourites/{book_id}" : {
      "delete" : {
        "operationId" : "remove",
        "parameters" : [ {
          "in" : "path",
          "name" : "book_id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Removes a book from the Favourites; removing one that isn't there changes nothing",
        "tags" : [ "favourite-controller" ]
      },
      "put" : {
        "operationId" : "add",
        "parameters" : [ {
          "in" : "path",
          "name" : "book_id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Adds a book to the Favourites; adding it again changes nothing",
        "tags" : [ "favourite-controller" ]
      }
    },
    "/api/v1/languages" : {
      "get" : {
        "operationId" : "languages",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "example" : [ {
                  "id" : 2,
                  "name" : "Armenian"
                }, {
                  "id" : 1,
                  "name" : "English"
                }, {
                  "id" : 3,
                  "name" : "Russian"
                } ],
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/NamedItemResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Every book language, sorted by name",
        "tags" : [ "catalog-lookup-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "BookDetailsResponse" : {
        "type" : "object",
        "properties" : {
          "authors" : {
            "type" : "array",
            "example" : [ {
              "id" : 1,
              "name" : "Robert C. Martin"
            } ],
            "items" : {
              "$ref" : "#/components/schemas/NamedItemResponse"
            }
          },
          "available" : {
            "type" : "boolean",
            "description" : "Whether at least one copy can be reserved now",
            "example" : true
          },
          "categories" : {
            "type" : "array",
            "example" : [ {
              "id" : 2,
              "name" : "Software Engineering"
            } ],
            "items" : {
              "$ref" : "#/components/schemas/NamedItemResponse"
            }
          },
          "copies_available" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 3
          },
          "cover_image_url" : {
            "type" : "string",
            "example" : "https://covers.openlibrary.org/b/id/8430006-L.jpg"
          },
          "description" : {
            "type" : "string",
            "example" : "Practical advice on writing readable, maintainable code."
          },
          "edition" : {
            "type" : [ "string", "null" ],
            "example" : "1st edition"
          },
          "favourite" : {
            "type" : "boolean",
            "description" : "Whether the logged-in user has this book in their Favourites",
            "example" : false
          },
          "id" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 1
          },
          "language" : {
            "$ref" : "#/components/schemas/NamedItemResponse",
            "example" : {
              "id" : 1,
              "name" : "English"
            }
          },
          "owner" : {
            "description" : "The teacher who owns the book; null for a University Book",
            "example" : {
              "id" : 4,
              "name" : "Ella Hovhannisyan"
            },
            "oneOf" : [ {
              "$ref" : "#/components/schemas/NamedItemResponse"
            }, {
              "type" : "null"
            } ]
          },
          "pdf_url" : {
            "type" : "string",
            "description" : "Download link; null when the book has no PDF",
            "example" : "https://archive.org/download/opensource/library_resource_21.pdf"
          },
          "publication_year" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 2008
          },
          "publisher" : {
            "$ref" : "#/components/schemas/NamedItemResponse",
            "example" : {
              "id" : 4,
              "name" : "Pearson"
            }
          },
          "rating" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Average stars, rounded to one decimal; null while the book has no reviews",
            "example" : 4.7
          },
          "subtitle" : {
            "type" : [ "string", "null" ],
            "example" : "A Handbook of Agile Software Craftsmanship"
          },
          "title" : {
            "type" : "string",
            "example" : "Clean Code"
          },
          "total_copies" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 6
          }
        }
      },
      "BookSummaryResponse" : {
        "type" : "object",
        "properties" : {
          "authors" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "example" : "Robert C. Martin"
            }
          },
          "available" : {
            "type" : "boolean",
            "description" : "Whether at least one copy can be reserved now",
            "example" : true
          },
          "cover_image_url" : {
            "type" : "string",
            "example" : "https://covers.openlibrary.org/b/id/8430006-L.jpg"
          },
          "favourite" : {
            "type" : "boolean",
            "description" : "Whether the logged-in user has this book in their Favourites",
            "example" : false
          },
          "has_pdf" : {
            "type" : "boolean",
            "example" : true
          },
          "id" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 1
          },
          "publisher" : {
            "type" : "string",
            "example" : "Pearson"
          },
          "rating" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Average stars, rounded to one decimal; null while the book has no reviews",
            "example" : 4.7
          },
          "subtitle" : {
            "type" : [ "string", "null" ],
            "example" : "A Handbook of Agile Software Craftsmanship"
          },
          "title" : {
            "type" : "string",
            "example" : "Clean Code"
          }
        }
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "example" : "anna.petrosyan@polytechnic.am",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "example" : "Library#2026",
            "minLength" : 1
          }
        },
        "required" : [ "email", "password" ]
      },
      "NamedItemResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 2
          },
          "name" : {
            "type" : "string",
            "example" : "Software Engineering"
          }
        }
      },
      "PageMetadata" : {
        "type" : "object",
        "properties" : {
          "number" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "total_elements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "total_pages" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "PageResponseBookSummaryResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/BookSummaryResponse"
            }
          },
          "page" : {
            "$ref" : "#/components/schemas/PageMetadata"
          }
        }
      },
      "PendingRegistrationResponse" : {
        "type" : "object",
        "properties" : {
          "code_expires_at" : {
            "type" : "string",
            "format" : "date-time",
            "example" : "2026-11-01T18:10:00Z"
          },
          "email" : {
            "type" : "string",
            "example" : "anna.petrosyan@polytechnic.am"
          },
          "resend_available_at" : {
            "type" : "string",
            "format" : "date-time",
            "example" : "2026-11-01T18:02:00Z"
          }
        }
      },
      "RefreshRequest" : {
        "type" : "object",
        "properties" : {
          "refresh_token" : {
            "type" : "string",
            "example" : "q3Jx9vZt0bWm2LkR8sYfH4nE6uA1cD7gP5oT3iV0xQw",
            "minLength" : 1
          }
        },
        "required" : [ "refresh_token" ]
      },
      "ResendCodeRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "example" : "anna.petrosyan@polytechnic.am",
            "maxLength" : 255,
            "minLength" : 0,
            "pattern" : "^[^@\\s]+@polytechnic\\.am$"
          }
        },
        "required" : [ "email" ]
      },
      "StartRegistrationRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "example" : "anna.petrosyan@polytechnic.am",
            "maxLength" : 255,
            "minLength" : 0,
            "pattern" : "^[^@\\s]+@polytechnic\\.am$"
          },
          "full_name" : {
            "type" : "string",
            "example" : "Anna Petrosyan",
            "maxLength" : 100,
            "minLength" : 2
          },
          "password" : {
            "type" : "string",
            "example" : "Library#2026"
          }
        },
        "required" : [ "email", "full_name" ]
      },
      "TokenPairResponse" : {
        "type" : "object",
        "properties" : {
          "access_token" : {
            "type" : "string",
            "example" : "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiI0MiIsInJvbGUiOiJzdHVkZW50In0.dGhpcy1pcy1hbi1leGFtcGxl"
          },
          "refresh_token" : {
            "type" : "string",
            "example" : "q3Jx9vZt0bWm2LkR8sYfH4nE6uA1cD7gP5oT3iV0xQw"
          }
        }
      },
      "VerifyCodeRequest" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "example" : "482913",
            "pattern" : "^\\d{6}$"
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "example" : "anna.petrosyan@polytechnic.am",
            "maxLength" : 255,
            "minLength" : 0,
            "pattern" : "^[^@\\s]+@polytechnic\\.am$"
          }
        },
        "required" : [ "email" ]
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
